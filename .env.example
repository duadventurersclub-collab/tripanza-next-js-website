# Original Tripanza settings
PORT=3000
API_KEY=
WP_WEBHOOK_SECRET=
ENABLE_NATIVE_LINK_CTA=false

# New team workspace (shares the existing CRM number)
BUSINESS_WORKSPACE_ENABLED=true
BUSINESS_AI_MODE=workspace
# Optional first-run credentials. Otherwise unique credentials are generated in
# business/data/credentials.json. Password must have at least 12 characters.
BUSINESS_ADMIN_EMAIL=admin@tripanza.local
BUSINESS_ADMIN_PASSWORD=
# On Render, set BUSINESS_DATA_DIR to a persistent disk mount, e.g. /var/data.
BUSINESS_DATA_DIR=
# WhatsApp sessions also use BUSINESS_DATA_DIR/whatsapp-auth when configured.
# Optional separate persistent auth root (contains both auth_crm and auth_notifications).
WHATSAPP_AUTH_DIR=

# Configurable OpenAI-compatible provider. Without a key, enquiries go to agents.
# You can also save the key in Workspace > Bot Config > AI connection.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o
AI_MAX_TOKENS=1024
TIMEZONE=Asia/Calcutta

# Website-only AI: manually selected tour URLs and their itineraries/accommodation.
# Add links in Workspace > Website knowledge; the default selection is empty.
WEBSITE_KNOWLEDGE_ENABLED=true
WEBSITE_URL=https://tripanza.com
WEBSITE_SYNC_HOURS=6
WEBSITE_MAX_TOURS=200
CONTEXT_EXPIRY_DAYS=90

# Optional explicit JWT secrets; otherwise separate persistent secrets are generated.
APP_SECRET=
REFRESH_SECRET=

# Optional stock integration and browser push
STOCK_CACHE_TTL_SECONDS=60
STOCK_CURRENCY=INR
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@tripanza.com
# Set FRONTEND_URL to the public HTTPS origin when hosting the workspace.
FRONTEND_URL=
