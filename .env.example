WORDPRESS_URL=http://localhost:10005
NEXT_PUBLIC_WORDPRESS_URL=http://localhost:10005
NEXT_PUBLIC_SITE_NAME=Tripanza
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999
REVALIDATION_SECRET=replace-with-a-long-random-secret
# Optional server-only error monitoring. Use the SAME random 32+ character
# secret in WordPress wp-config.php as TRIPANZA_MONITORING_SECRET. Leave blank
# until configured; never name this variable NEXT_PUBLIC_… or commit its value.
TRIPANZA_MONITORING_SECRET=

# Optional integrated WhatsApp bot. Server-only: never use NEXT_PUBLIC_ for secrets.
# On Render Free, session files disappear after a restart or spin-down.
TRIPANZA_WHATSAPP_ENABLED=false
TRIPANZA_WHATSAPP_AUTH_DIR=/tmp/tripanza-whatsapp
TRIPANZA_WHATSAPP_ALLOW_EPHEMERAL_AUTH=yes
TRIPANZA_WHATSAPP_KEEP_AWAKE=true
TRIPANZA_WHATSAPP_API_KEY=
WP_WEBHOOK_SECRET=
